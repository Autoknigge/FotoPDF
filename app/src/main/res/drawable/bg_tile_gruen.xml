<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
    <layer-list>
        <item
            android:left="4dp"
            android:top="5dp">
            <shape android:shape="rectangle">
                <solid android:color="#0A120D" />
                <corners android:radius="20dp" />
            </shape>
        </item>
        <item
            android:bottom="5dp"
            android:right="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="315"
                    android:endColor="#1D4A37"
                    android:startColor="#6C9C85" />
                <stroke
                    android:width="2.5dp"
                    android:color="#C9A648" />
                <corners android:radius="20dp" />
            </shape>
        </item>
    </layer-list>
    </item>
</ripple>
